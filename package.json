{
  "name": "spelling-ukraine",
  "root": true,
  "private": true,
  "workspaces": [
    "data",
    "discord-bot",
    "reddit-bot",
    "twitter-bot",
    "web"
  ],
  "scripts": {
    "start:discord-bot": "npm run start --workspace=discord-bot",
    "start:reddit-bot": "npm run start --workspace=reddit-bot",
    "start:twitter-bot": "npm run start --workspace=twitter-bot",
    "start:web": "npm run start --workspace=web",
    "lint": "npm run lint --workspaces --if-present",
    "lint:check": "npm run lint:check --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present"
  }
}
