{
  "root": true,
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=16"
  },
  "workspaces": [
    "data",
    "discord-bot",
    "reddit-bot",
    "twitter-bot",
    "web"
  ],
  "scripts": {
    "start:discord-bot": "pnpm --filter ./discord-bot start",
    "start:reddit-bot": "pnpm --filter ./reddit-bot start",
    "start:twitter-bot": "pnpm --filter ./twitter-bot start",
    "start:web": "pnpm --filter ./web start",
    "lint": "pnpm -r --filter \"./*\" run lint",
    "lint:check": "pnpm -r --filter \"./*\" run lint:check",
    "format": "pnpm -r --filter \"./*\" run format",
    "format:check": "pnpm -r --filter \"./*\" run format:check"
  }
}
